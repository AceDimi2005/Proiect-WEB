<div id="print-watermark" aria-hidden="true">Pirvanescu Dimitrie-Alexandru</div>

	<header>
	    <h1>TechForge</h1>
	    <img src="/resurse/imagini/sigla.png" alt="Sigla TechForge" />
	    <div class="form-check form-switch comutator-tema">
	        <input class="form-check-input" type="checkbox" role="switch" id="switch-tema" aria-label="Schimba tema site-ului" />
	        <label class="form-check-label" for="switch-tema">
	            <i class="bi bi-sun-fill icon-tema icon-tema-light" aria-hidden="true"></i>
	            <i class="bi bi-moon-stars-fill icon-tema icon-tema-dark" aria-hidden="true"></i>
	        </label>
	    </div>

	    <nav class="site-nav" aria-label="Meniu principal">
        <input type="checkbox" id="ch-menu" aria-label="Deschide sau inchide meniul" />
        <label id="hamburger" for="ch-menu" aria-hidden="true">
            <i class="fa-solid fa-bars"></i>
        </label>

        <ul class="meniu">
            <li class="home-item has-submenu">
                <a href="/">
                    <i class="fa-solid fa-house menu-icon" aria-hidden="true"></i>
                    <span class="item-label">Acasa</span>
                </a>
                <ul class="submenu">
                    <li><a href="/#welcome">Bine ati venit</a></li>
                    <li><a href="/#promotii">Promotii si oferte</a></li>
                    <li><a href="/#produse">Produsele noastre</a></li>
                    <li><a href="/#orar">Orar</a></li>
                    <li><a href="/#anunturi">Anunturi</a></li>
                    <li><a href="/#evenimente">Evenimente</a></li>
                    <li><a href="/#index-intrebari">Intrebari frecvente</a></li>
                    <li><a href="/#galerie-statica">Galerie statica</a></li>
                    <li><a href="/#help">Tutoriale si ghiduri</a></li>
                </ul>
            </li>

            <li>
                <a href="/despre">
                    <i class="fa-solid fa-circle-info menu-icon" aria-hidden="true"></i>
                    <span class="item-label">Despre</span>
                </a>
            </li>

            <li class="has-submenu">
                <a href="/produse">
                    <i class="fa-solid fa-box-open menu-icon" aria-hidden="true"></i>
                    <span class="item-label">Produse</span>
                </a>
                <ul class="submenu">
                    <li><a href="/produse">Toate produsele</a></li>
                    <li><a href="/seturi">Seturi de produse</a></li>
                    <% if (typeof categoriiProduse !== "undefined") { %>
                        <% for (const categorie of categoriiProduse) { %>
                            <li><a href="<%= categorie.url %>"><%= categorie.eticheta %></a></li>
                        <% } %>
                    <% } %>
                </ul>
            </li>

            <li>
                <a href="/cos">
                    <i class="fa-solid fa-cart-shopping menu-icon" aria-hidden="true"></i>
                    <span class="item-label">Cos</span>
                </a>
            </li>

            <li class="has-submenu">
                <a href="/galerie-statica">
                    <i class="fa-solid fa-images menu-icon" aria-hidden="true"></i>
                    <span class="item-label">Galerie</span>
                </a>
                <ul class="submenu">
                    <li><a href="/galerie-statica">Galerie statica</a></li>
                    <li><a href="/galerie-dinamica">Galerie dinamica</a></li>
                </ul>
            </li>

            <li>
                <a href="/contact">
                    <i class="fa-solid fa-envelope menu-icon" aria-hidden="true"></i>
                    <span class="item-label">Contact</span>
                </a>
            </li>
        </ul>
    </nav>
</header>
